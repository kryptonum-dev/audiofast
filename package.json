{
  "name": "audiofast",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "bun run turbo build",
    "dev": "bun run turbo dev --filter=web --filter=studio",
    "dev:all": "bun run turbo dev",
    "dev:b2c-admin": "bun run turbo dev --filter=b2c-admin",
    "dev:cms-activity": "bun run turbo dev --filter=cms-activity",
    "lint": "bun run turbo lint",
    "check-types": "bun run turbo check-types",
    "test": "bun run turbo test",
    "format": "bun run prettier --write \"**/*.{ts,tsx,md}\"",
    "typegen": "cd apps/studio && bunx sanity schema extract --force && bunx sanity typegen generate",
    "check:parity": "bun apps/web/scripts/check-parity.ts",
    "check:stega-leaks": "bun apps/web/scripts/check-stega-leaks.ts",
    "scan:dataset-stega": "bun apps/web/scripts/scan-dataset-stega.ts",
    "blueprints:deploy": "bunx sanity blueprints deploy",
    "walkthrough:summary": "bun scripts/walkthrough/summarize-results.ts",
    "seed:qa-presentation": "cd apps/studio && bun run scripts/seed/apply-qa-presentation.ts"
  },
  "devDependencies": {
    "@sanity/blueprints": "0.28.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.3.2",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "core-js-pure",
    "studio"
  ],
  "browserslist": {
    "production": [
      "last 2 Chrome versions",
      "last 2 Edge versions",
      "last 2 Firefox versions",
      "last 2 Safari versions"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Firefox version",
      "last 1 Safari version"
    ]
  },
  "dependencies": {
    "@sanity/cli": "^8.24.0"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
