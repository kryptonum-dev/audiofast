{
  "name": "audiofast",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "bun run turbo build",
    "dev": "bun run turbo dev --filter=web --filter=studio",
    "dev:all": "bun run turbo dev",
    "dev:b2c-admin": "bun run turbo dev --filter=b2c-admin",
    "lint": "bun run turbo lint",
    "check-types": "bun run turbo check-types",
    "format": "bun run prettier --write \"**/*.{ts,tsx,md}\"",
    "typegen": "cd apps/studio && bunx sanity schema extract --force && bunx sanity typegen generate"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.2",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "core-js-pure",
    "studio"
  ],
  "browserslist": {
    "production": [
      "last 2 Chrome versions",
      "last 2 Edge versions",
      "last 2 Firefox versions",
      "last 2 Safari versions"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Firefox version",
      "last 1 Safari version"
    ]
  },
  "dependencies": {
    "@sanity/cli": "^8.2.1"
  }
}
