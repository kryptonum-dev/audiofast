    {"@context":"https://schema.org","@id":"{origin}#organization","@type":["Organization","LocalBusiness","Store"],"address":{"@type":"PostalAddress","addressCountry":"PL","addressLocality":"Łódź","postalCode":"91-174","streetAddress":"ul. Romanowska 55e, pasaż lok. 9"},"contactPoint":{"@type":"ContactPoint","availableLanguage":["pl","en"],"contactType":"customer service","email":"info@audiofast.pl","telephone":"426 133 750"},"description":"Oferujemy sprzęt audio klasy premium – urządzenia, które od lat wyznaczają standardy doskonałości. Poczuj brzmienie, które przeniesie Cię bliżej muzyki niż kiedykolwiek wcześniej.","email":"info@audiofast.pl","geo":{"@type":"GeoCoordinates","latitude":51.7592485,"longitude":19.4559833},"image":"https://cdn.sanity.io/images/fsw3likv/production/a6a4e1253977ee75afc4456116789378930b5165-433x436.svg","logo":"https://cdn.sanity.io/images/fsw3likv/production/a6a4e1253977ee75afc4456116789378930b5165-433x436.svg","name":"AUDIOFAST Sp. z o.o.","priceRange":"$$$$","sameAs":["https://www.instagram.com/audiofast.pl/","https://www.linkedin.com/feed/","https://www.youtube.com/@audiofast-pl","https://www.facebook.com/audiofast/?locale=pl_PL"],"telephone":"426 133 750","url":"{origin}"},
