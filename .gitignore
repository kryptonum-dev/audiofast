# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.bak-*

# Testing
coverage
.playwright-mcp/

# Turbo
.turbo

# Vercel
.vercel

# Cursor local MCP config may contain access tokens
.cursor/mcp.json

# Build Outputs
.next/
out/
build
dist
*.tsbuildinfo


# Debug
npm-debug.log*

# Misc
.DS_Store
*.pem

# Data files
*.sql
!supabase/migrations/*.sql
*.csv

# Supabase local CLI state
supabase/.temp/

# Parity crawler scratch runs (the baseline is committed)
context/changes/*/parity/runs/

# Sanity Functions: per-function bundle output, and Blueprint runtime state.
# blueprint.config.json IS tracked on purpose: it records the Blueprint<->Stack
# linkage, and re-running `sanity blueprints init` without it mints a duplicate
# stack.
apps/functions/**/.build/
/.sanity/*
!/.sanity/blueprint.config.json
