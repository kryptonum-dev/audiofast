{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "bun run sanity dev --port 3333",
    "format": "bun run prettier --write .",
    "start": "bun run sanity start",
    "lint": "bun run eslint .",
    "build": "bun run sanity build",
    "deploy": "bun run sanity deploy",
    "type": "bun run sanity schema extract --force --enforce-required-fields && bun run sanity typegen generate",
    "check-types": "bun run tsc --noEmit",
    "migrate:denormalize": "bun run scripts/migrate-denormalized-fields.ts",
    "migrate:denormalize:dry": "bun run scripts/migrate-denormalized-fields.ts --dry-run --verbose"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sanity/assist": "^6.1.21",
    "@sanity/embeddings-index-ui": "^4.0.17",
    "@sanity/icons": "^3.8.0",
    "@sanity/orderable-document-list": "2.0.20",
    "@sanity/ui": "^3.5.3",
    "@sanity/vision": "^6.10.1",
    "classnames": "^2.5.1",
    "lodash.debounce": "^4.0.8",
    "lodash.get": "^4.4.2",
    "lucide-react": "^1.33.0",
    "nanoid": "^6.0.1",
    "pluralize": "^8.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "rxjs": "^7.8.2",
    "sanity": "^6.10.1",
    "sanity-plugin-media": "^6.1.6",
    "slugify": "^1.6.6",
    "styled-components": "^6.5.3",
    "@workspace/youtube": "workspace:*"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.get": "^4.4.9",
    "@types/node": "^24.13.3",
    "@types/pluralize": "^0.0.33",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "csv-parse": "^6.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "node-html-parser": "^7.1.0",
    "p-limit": "^3.1.0",
    "sharp": "^0.34.5",
    "typescript": "5.9.3",
    "uuid": "^11.1.0"
  }
}
