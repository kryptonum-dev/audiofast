{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "bun run sanity dev --port 3333",
    "format": "bun run prettier --write .",
    "start": "bun run sanity start",
    "lint": "bun run eslint .",
    "build": "bun run sanity build",
    "deploy": "bun run sanity deploy",
    "type": "bun run sanity schema extract --force --enforce-required-fields && bun run sanity typegen generate",
    "check-types": "bun run tsc --noEmit",
    "migrate:denormalize": "bun run scripts/migrate-denormalized-fields.ts",
    "migrate:denormalize:dry": "bun run scripts/migrate-denormalized-fields.ts --dry-run --verbose",
    "test": "vitest run"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sanity/assist": "^6.2.5",
    "@sanity/icons": "^5.2.3",
    "@sanity/orderable-document-list": "^2.0.28",
    "@sanity/ui": "^4.4.10",
    "@sanity/vision": "^6.20.0",
    "classnames": "^2.5.1",
    "lodash.debounce": "^4.0.8",
    "lodash.get": "^4.4.2",
    "lucide-react": "^1.62.0",
    "nanoid": "^6.0.2",
    "pluralize": "^8.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "^6.1.6",
    "rxjs": "^7.8.2",
    "sanity": "^6.20.0",
    "sanity-plugin-media": "^6.5.0",
    "slugify": "^1.6.6",
    "styled-components": "^6.6.0",
    "@workspace/youtube": "workspace:*",
    "@sanity/client": "^8.11.0"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.get": "^4.4.9",
    "@types/node": "^24.19.2",
    "@types/pluralize": "^0.0.33",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "csv-parse": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "groq-js": "2.0.0",
    "node-html-parser": "^9.0.5",
    "p-limit": "^7.3.3",
    "sharp": "^0.35.5",
    "typescript": "6.0.3",
    "uuid": "^14.0.3",
    "vitest": "^5.0.5"
  }
}
