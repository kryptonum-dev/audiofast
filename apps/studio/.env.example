SANITY_STUDIO_DATASET=production
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_TITLE="Audiofast Studio"
# Where the Presentation tool („Podgląd") points its iframe in a BUILT Studio
# (`sanity dev` always uses http://localhost:3000). Inlined at build time —
# set it before `sanity build` / `sanity deploy`. Non-secret.
SANITY_STUDIO_PRESENTATION_URL=https://audiofast.pl
# Ships „Podgląd" in a BUILT Studio (`sanity dev` always has it). Hidden in the
# deployed Studio until editors are told about it — set to true, then deploy.
SANITY_STUDIO_PRESENTATION_ENABLED=false
