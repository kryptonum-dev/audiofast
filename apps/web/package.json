{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "bun run next dev --turbopack",
    "build": "bun run verify:build-env && bun run generate:redirects && bun run next build",
    "start": "bun run next start",
    "lint": "bun run eslint .",
    "format": "bun run prettier --write .",
    "check-types": "bun run tsc --noEmit",
    "generate:redirects": "bun run scripts/generate-redirects.ts",
    "verify:build-env": "bun run scripts/verify-build-env.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "bun --env-file=.env.e2e.local playwright test",
    "test:e2e:ui": "bun --env-file=.env.e2e.local playwright test --ui",
    "test:e2e:headed": "bun --env-file=.env.e2e.local playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not ie 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@portabletext/react": "^8.0.1",
    "@portabletext/to-html": "^6.0.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/client": "^8.11.0",
    "@sanity/image-url": "^2.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/edge-config": "^1.5.1",
    "botid": "^1.5.11",
    "embla-carousel-react": "^8.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "next-sanity": "^13.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-leaflet": "^5.0.0",
    "sass": "^1.106.1",
    "server-only": "^0.0.1",
    "slugify": "^1.6.9",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "@workspace/youtube": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/mailchimp__mailchimp_marketing": "^3.0.22",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.3",
    "minimatch": "^10.2.6",
    "msw": "^3.0.3",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
