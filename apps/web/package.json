{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run next dev --turbopack",
    "build": "bun run verify:build-env && bun run generate:redirects && bun run next build",
    "start": "bun run next start",
    "lint": "bun run eslint .",
    "format": "bun run prettier --write .",
    "check-types": "bun run tsc --noEmit",
    "generate:redirects": "bun run scripts/generate-redirects.ts",
    "verify:build-env": "bun run scripts/verify-build-env.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "bun --env-file=.env.e2e.local playwright test",
    "test:e2e:ui": "bun --env-file=.env.e2e.local playwright test --ui",
    "test:e2e:headed": "bun --env-file=.env.e2e.local playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not ie 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@portabletext/react": "^7.0.1",
    "@portabletext/to-html": "^6.0.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sanity/asset-utils": "^2.2.1",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.1.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/edge-config": "^1.5.1",
    "botid": "^1.5.11",
    "embla-carousel-react": "^8.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "next-sanity": "^13.3.3",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "react-leaflet": "^5.0.0",
    "sass": "^1.103.1",
    "server-only": "^0.0.1",
    "slugify": "^1.6.9",
    "sonner": "^2.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.22",
    "@types/mailchimp__mailchimp_marketing": "^3.0.22",
    "@types/node": "^24.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^29.0.2",
    "minimatch": "^10.2.6",
    "msw": "^2.13.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
